# ─── Segreti obbligatori ──────────────────────────────────────────────────
# Token del bot, dalla pagina "Bot" del Discord Developer Portal.
TOKEN=IL_TUO_TOKEN_DISCORD

# Client ID (Application ID) dell'applicazione, dalla pagina "General Information".
CLIENT_ID=1234567890123456789

# ─── Facoltativi ───────────────────────────────────────────────────────────
# ID del server "di test" su cui registrare i comandi slash istantaneamente
# (senza attendere fino a 1h di propagazione globale). Se non impostato,
# vengono registrati solo i comandi globali.
GUILD_ID=1234567890123456789

# ID del founder/owner del bot: unico utente che può usare /config whitelist,
# impostare il ruolo immune, e i comandi con prefisso "!" (lock/unlock/concedi).
# Se non impostato viene usato il valore di default presente in index.js.
OWNER_ID=1234567890123456789
